-- Specs and the mock define the WoW globals they need.
files["tests/"] = {
	std = "+busted",
	globals = { "WowMock" },
	allow_defined_top = true,
	ignore = { "111", "112", "113", "121", "122", "143", "211/ADDON_NAME" },
}
