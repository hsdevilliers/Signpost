-- luacheck config: the WoW client runs Lua 5.1 plus the globals listed here.
std = "lua51"
max_line_length = 120
codes = true

-- .lua/, .luarocks/ and .install/ are where CI's Lua setup actions install the toolchain inside the checkout. .claude/ holds the git
-- worktrees of other branches (StyLua skips them through .gitignore, luacheck does not): their files are not this checkout's.
exclude_files = { "Libs/", "tools/bin/", ".venv/", "dist/", ".release/", ".lua/", ".luarocks/", ".install/", "plans/", ".claude/" }

-- Guide text is one DSL statement per line (a .note cannot be wrapped): line length is not checked there.
files["Guides/**/*.lua"] = { max_line_length = false }

ignore = {
	"211/ADDON_NAME", -- every file opens with `local ADDON_NAME, ns = ...`
	"212/self",
}

-- Globals the addon may set (CLAUDE.md: SavedVariables and names the client requires).
globals = {
	"SignpostDB",
	"SignpostCharDB",
	"SLASH_SIGNPOST1",
	"SLASH_SIGNPOST2",
	"SlashCmdList",
	"Signpost_OnAddonCompartmentClick",
	-- Core/Pace.lua swaps it for a no-op while its own /played request is out (and restores it).
	"ChatFrame_DisplayTimePlayed",
}

